{
  "manifest_version": 3,
  "name": "双木林网申助手",
  "version": "1.0.0",
  "description": "AI解析简历，自动填写网申表单",
  "permissions": ["storage"],
  "host_permissions": ["https://*/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "双木林网申助手 - AI自动填表"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
